# Required: bot token from @BotFather (https://core.telegram.org/bots/tutorial#obtain-your-bot-token)
BOT_TOKEN=

# Optional. Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Optional. How long successful results stay cached (default 300 = 5 minutes)
CACHE_TTL_SECONDS=300

# Optional. Per-attempt timeout for Open-Meteo calls (default 3000 ms; one retry on timeout)
HTTP_TIMEOUT_MS=3000

# Optional. Maximum time a user waits for a reply, across all calls for one command (default 8000 ms)
COMMAND_TIMEOUT_MS=8000
